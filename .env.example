# PostgreSQL connection string (e.g. Neon, Supabase, local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"

# next-auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# Seed admin credentials (used by `npm run db:seed`)
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Portfolio Admin"

# AI providers — required for admin-side "Generate tailored resume".
# Server-side only; never exposed to the browser. Configure one or both: when
# both are set the first one below is tried first and the other is used as an
# automatic fallback.

# Google Gemini
GEMINI_API_KEY=""
# Optional: override the Gemini model (defaults to gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# Groq
GROQ_API_KEY=""
# Optional: override the Groq model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL="llama-3.3-70b-versatile"
