# PostgreSQL connection string (e.g. Neon, Supabase, local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"

# next-auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# Seed admin credentials (used by `npm run db:seed`)
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Portfolio Admin"
